{
  "name": "dsh-ollama-web-search",
  "version": "0.1.0",
  "private": true,
  "description": "Ollama 云 web_search provider：web_search 工具直连 ollama.com/api/web_search（原生搜索 API，返回 {results:[{title,url,content}]}），转成 dsh 的 sources 格式。替代 DeepSeek 官方搜索，无需本地 Ollama/中间件，无模型开销。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
